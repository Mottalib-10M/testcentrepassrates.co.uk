---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/test-centre-finder/" title="Driving test centre finder" width="100%" height="900" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the driving test centre finder on your website" description="Put the driving test centre finder on your website for free: one iframe, every car test centre in Britain with its DVSA pass rate and wait, no sign-up and no tracking." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the test centre finder</h1>
    <p class="mt-3 text-lg text-navy-700">For an instructor's website, a college's learner page or a youth service: visitors type a postcode and see the car test centres around it, with their pass rate and current wait.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the finder visible and use it as it is, without warranty. When DVSA publishes new tables, the embedded finder updates itself.</p>
    <p>Nothing your visitors type reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/test-centre-finder/" title="Driving test centre finder" width="100%" height="900" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
