---
/** Embeddable finder (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import CentreFinder from '../../components/calc/CentreFinder';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Driving test centre finder (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <CentreFinder client:load q="B1" methodHref={`${SITE_URL}${route('method', 'en')}`} />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · DVSA car test tables (Open Government Licence), worked out in your browser</p>
  </body>
</html>
